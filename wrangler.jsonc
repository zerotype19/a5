{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a5-home-services",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "100460eb8ce84b12a136617372d9aba6"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ENABLE_LAUNCH_PIPELINE": "true",
    "ENABLE_OPERATIONS_ALERTS": "true",
    "ENABLE_LEAD_OUTCOMES": "true",
    "OPERATIONS_ALERT_EMAIL": "hello@a5homeservices.com"
  }
}
