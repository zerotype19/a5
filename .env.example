# Environment variable names (no secrets)

Copy to `.env.local` for local development. Fill values from secure owner vaults — never commit real secrets.

See `/docs/SECRETS.md` for descriptions.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend ---
RESEND_API_KEY=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- GA4 ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Feature flags (disabled by default) ---
ENABLE_AI_CLASSIFICATION=false
ENABLE_VENDOR_SCORING=false
ENABLE_SMS=false
ENABLE_AUTOMATIC_ROUTING=false
ENABLE_PROGRAMMATIC_PUBLISHING=false
